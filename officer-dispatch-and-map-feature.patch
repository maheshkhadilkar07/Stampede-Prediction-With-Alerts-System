+ * templates that need it) helpers used across the "zone of stampede" /
+ * officer-dispatch feature:
+ *
+ *   initStampedeMap(mapElementId, alertsApiUrl, officersApiUrl)
+ *     -> renders the live situation map on the Alerts page: one marker
+ *        per geotagged alert (colored by risk level) plus a marker for
+ *        the officer dispatched to it, joined by a dashed line.
+ *
+ *   initLocationPicker(mapElementId, latInputId, lonInputId, opts)
+ *     -> a click-to-place-a-pin map used on Upload / Live CCTV / Officers
+ *        forms so a location can be set without typing raw coordinates.
+ */
+
+const RISK_COLORS = {
+  SAFE: "#28a745",
+  LOW: "#ffc107",
+  MEDIUM: "#fd7e14",
+  HIGH: "#dc3545",
+  CRITICAL: "#7d0d1b",
+};
+
+const MAP_TILE_URL = "https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png";
+const MAP_TILE_ATTRIBUTION =
+  '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors &copy; <a href="https://carto.com/attributions">CARTO</a>';
+const DEFAULT_CENTER = [21.1458, 79.0882]; // Nagpur, India — sensible fallback if nothing is geotagged yet
+
+function riskColor(level) {
+  return RISK_COLORS[level] || "#38bdf8";
+}
+
+function zoneIcon(color) {
+  return L.divIcon({
+    className: "",
+    html: `<div style="width:16px;height:16px;border-radius:50%;background:${color};
+            box-shadow:0 0 0 4px ${color}33, 0 0 10px ${color}aa;border:2px solid #fff;"></div>`,
+    iconSize: [16, 16],
+    iconAnchor: [8, 8],
+  });
+}
+
+function officerIcon() {
+  return L.divIcon({
+    className: "",
+    html: `<div style="width:14px;height:14px;border-radius:3px;background:#38bdf8;
+            border:2px solid #fff;box-shadow:0 0 8px #38bdf8aa;"></div>`,
+    iconSize: [14, 14],
+    iconAnchor: [7, 7],
+  });
+}
+
+/** Live situation map: alert zones + dispatched officers. */
+function initStampedeMap(mapElementId, alertsApiUrl, officersApiUrl) {
+  const el = document.getElementById(mapElementId);
+  if (!el || typeof L === "undefined") return;
+
+  const map = L.map(mapElementId, { scrollWheelZoom: false }).setView(DEFAULT_CENTER, 12);
+  L.tileLayer(MAP_TILE_URL, { attribution: MAP_TILE_ATTRIBUTION, maxZoom: 19 }).addTo(map);
+
+  function render() {
+    fetch(alertsApiUrl)
+      .then((r) => r.json())
+      .then((alertsData) => {
+        const bounds = [];
+        const layer = L.layerGroup().addTo(map);
+
+        alertsData.forEach((a) => {
+          const color = riskColor(a.risk_level);
+          const zoneMarker = L.marker([a.latitude, a.longitude], { icon: zoneIcon(color) }).addTo(layer);
+          zoneMarker.bindPopup(
+            `<b>${a.zone_name || "Unnamed zone"}</b><br>` +
+              `<span style="color:${color}">${a.risk_level}</span> — ${a.message}<br>` +
+              `<span style="opacity:.7">${a.created_at}</span>`
+          );
+          bounds.push([a.latitude, a.longitude]);
+
+          if (a.officer && a.officer.latitude != null && a.officer.longitude != null) {
+            const officerMarker = L.marker([a.officer.latitude, a.officer.longitude], {
+              icon: officerIcon(),
+            }).addTo(layer);
+            officerMarker.bindPopup(
+              `<b>${a.officer.name}</b> (dispatched)<br>` +
+                `${a.officer.distance_km != null ? a.officer.distance_km + " km from zone" : ""}<br>` +
+                `${a.officer.phone_number ? "📞 " + a.officer.phone_number : ""}`
+            );
+            L.polyline(
+              [
+                [a.officer.latitude, a.officer.longitude],
+                [a.latitude, a.longitude],
+              ],
+              { color: "#38bdf8", weight: 2, dashArray: "6 6", opacity: 0.8 }
+            ).addTo(layer);
+            bounds.push([a.officer.latitude, a.officer.longitude]);
+          }
+        });
+
+        if (officersApiUrl) {
+          fetch(officersApiUrl)
+            .then((r) => r.json())
+            .then((officers) => {
+              officers.forEach((o) => {
+                if (!o.on_duty) return;
+                L.circleMarker([o.latitude, o.longitude], {
+                  radius: 5,
+                  color: "#818cf8",
+                  fillColor: "#818cf8",
+                  fillOpacity: 0.6,
+                })
+                  .addTo(layer)
+                  .bindPopup(`<b>${o.name}</b><br>${o.zone_name || "On patrol"}<br>On duty`);
+              });
+            })
+            .catch(() => {});
+        }
+
+        if (bounds.length) {
+          map.fitBounds(bounds, { padding: [40, 40], maxZoom: 15 });
+        }
+      })
+      .catch(() => {});
+  }
+
+  render();
+  return map;
+}
+
+/** Click-to-place-a-pin picker used on Upload / Live CCTV / Officers forms. */
+function initLocationPicker(mapElementId, latInputId, lonInputId, opts) {
+  opts = opts || {};
+  const el = document.getElementById(mapElementId);
+  const latInput = document.getElementById(latInputId);
+  const lonInput = document.getElementById(lonInputId);
+  if (!el || !latInput || !lonInput || typeof L === "undefined") return;
+
+  const initialLat = parseFloat(latInput.value);
+  const initialLon = parseFloat(lonInput.value);
+  const hasInitial = !isNaN(initialLat) && !isNaN(initialLon);
+  const startCenter = hasInitial ? [initialLat, initialLon] : DEFAULT_CENTER;
+
+  const map = L.map(mapElementId, { scrollWheelZoom: false }).setView(startCenter, hasInitial ? 15 : 12);
+  L.tileLayer(MAP_TILE_URL, { attribution: MAP_TILE_ATTRIBUTION, maxZoom: 19 }).addTo(map);
+
+  let marker = hasInitial ? L.marker(startCenter, { draggable: true }).addTo(map) : null;
+
+  function setPoint(latlng) {
+    latInput.value = latlng.lat.toFixed(6);
+    lonInput.value = latlng.lng.toFixed(6);
+    if (marker) {
+      marker.setLatLng(latlng);
+    } else {
+      marker = L.marker(latlng, { draggable: true }).addTo(map);
+      marker.on("dragend", () => setPoint(marker.getLatLng()));
+    }
+  }
+
+  if (marker) {
+    marker.on("dragend", () => setPoint(marker.getLatLng()));
+  }
+
+  map.on("click", (e) => setPoint(e.latlng));
+
+  // Try to center on the browser's current location for convenience,
+  // but never overwrite a location the record already has.
+  if (!hasInitial && opts.geolocate !== false && navigator.geolocation) {
+    navigator.geolocation.getCurrentPosition(
+      (pos) => {
+        map.setView([pos.coords.latitude, pos.coords.longitude], 14);
+      },
+      () => {},
+      { timeout: 4000 }
+    );
+  }
+
+  return map;
+}
