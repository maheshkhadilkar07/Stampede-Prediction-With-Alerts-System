+    if they do not already exist, and patch any missing columns onto
+    tables that were created by an older version of this app.
     """
     db.init_app(app)
     with app.app_context():
@@ -31,3 +76,4 @@ def init_db(app):
         # `db` before create_all() runs, without causing circular imports.
         from database import models  # noqa: F401
