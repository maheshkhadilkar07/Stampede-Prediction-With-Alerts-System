+def describe_hotspot(grid) -> str:
+    """
+    Turn the density grid's single most-crowded cell into a short,
+    human-readable position within the camera's field of view (e.g.
+    "north-east area of frame"). This is what lets an alert message say
+    *where in the shot* the danger is building, not just "somewhere".
+
+    Returns None if there is no grid or every cell is empty.
+    """
+    if grid is None or grid.size == 0 or grid.max() == 0:
+        return None
+
+    rows, cols = grid.shape
+    row, col = np.unravel_index(int(np.argmax(grid)), grid.shape)
+
+    v_pos = "north" if row < rows / 3 else ("south" if row >= 2 * rows / 3 else "")
+    h_pos = "west" if col < cols / 3 else ("east" if col >= 2 * cols / 3 else "")
+
+    if not v_pos and not h_pos:
+        return "center of frame"
+    label = "-".join(p for p in (v_pos, h_pos) if p)
+    return f"{label} area of frame"
+
+
