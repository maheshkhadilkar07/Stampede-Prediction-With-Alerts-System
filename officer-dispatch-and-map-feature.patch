@@ -76,6 +76,75 @@ def _send_email(subject, body, recipients):
         logger.exception(f"Failed to send alert email: {exc}")
 
 
+def notify_nearest_officer_async(alert_id):
+    """Fire-and-forget: find and dispatch the nearest on-duty officer to alert_id."""
+    t = threading.Thread(target=_notify_nearest_officer, args=(alert_id,))
+    t.daemon = True
+    t.start()
+
+
+def _notify_nearest_officer(alert_id):
+    if not config.ADMIN_ALERT_ENABLED:
+        return
+
+    from datetime import datetime
+
+    from app import app  # local import — avoids circular import at module load
+    from database.database import db
+    from database.models import Alert
+    from utils.geo import find_nearest_officer, maps_directions_url
+
+    with app.app_context():
+        alert = db.session.get(Alert, alert_id)
+        if alert is None:
+            return
+        if alert.latitude is None or alert.longitude is None:
+            logger.info(
+                f"Alert {alert_id} has no known location — skipping officer dispatch "
+                f"(tag the video with a zone/latitude/longitude to enable this)."
+            )
+            return
+
+        officer, distance_km = find_nearest_officer(alert.latitude, alert.longitude)
+        if officer is None:
+            logger.warning(
+                f"No on-duty officer with a known location to dispatch for alert {alert_id}."
+            )
+            return
+
+        alert.dispatched_officer_id = officer.id
+        alert.dispatched_distance_km = distance_km
+        alert.dispatched_at = datetime.utcnow()
+        db.session.commit()
+
+        zone = alert.zone_name or "the monitored zone"
+        directions = maps_directions_url(alert.latitude, alert.longitude)
+        subject = f"[StampedeGuard] DISPATCH: {alert.risk_level} risk at {zone}"
+        body = (
+            f"You are the nearest on-duty officer ({distance_km} km away) to a "
+            f"{alert.risk_level} risk stampede alert.\n\n"
+            f"Zone: {zone}\n"
+            f"Details: {alert.message}\n"
+            f"Coordinates: {alert.latitude}, {alert.longitude}\n"
+            f"Directions: {directions}\n\n"
+            f"Please proceed to the location immediately."
+        )
+
+        if officer.email:
+            _send_email(subject, body, [officer.email])
+        if officer.phone_number:
+            _send_sms(
+                f"DISPATCH: {alert.risk_level} risk at {zone}, {distance_km}km from you. "
+                f"Directions: {directions}",
+                [officer.phone_number],
+            )
+
+        logger.warning(
+            f"Dispatched officer '{officer.name}' ({distance_km} km away) to alert {alert_id} "
+            f"[{alert.risk_level} @ {zone}]."
+        )
+
+
