new file mode 100644
index 0000000..f1ccfa9
--- /dev/null
+++ b/utils/geo.py
@@ -0,0 +1,63 @@
+"""
+utils/geo.py
+=============
+Small geo-distance helpers used to map a stampede alert to a physical
+zone and find the nearest on-duty officer to dispatch to it.
+
+Deliberately dependency-free (plain math, no geopy/pyproj) since we only
+need "who is closest" over a handful of officer records, not
+survey-grade geodesy.
+
+Save this file at: Stampede-Prediction-System/utils/geo.py
+"""
+
+import math
+
+EARTH_RADIUS_KM = 6371.0
+
+
+def haversine_km(lat1: float, lon1: float, lat2: float, lon2: float) -> float:
+    """Great-circle distance in kilometers between two lat/lon points."""
+    phi1, phi2 = math.radians(lat1), math.radians(lat2)
+    dphi = math.radians(lat2 - lat1)
+    dlambda = math.radians(lon2 - lon1)
+
+    a = math.sin(dphi / 2) ** 2 + math.cos(phi1) * math.cos(phi2) * math.sin(dlambda / 2) ** 2
+    a = min(1.0, max(0.0, a))  # guard against tiny float overshoot past domain
+    return 2 * EARTH_RADIUS_KM * math.asin(math.sqrt(a))
+
+
+def find_nearest_officer(latitude: float, longitude: float, on_duty_only: bool = True):
+    """
+    Find the on-duty Officer whose last-known location is closest to
+    (latitude, longitude).
+
+    Returns (officer, distance_km) or (None, None) if there is no
+    candidate officer with a known location.
+    """
+    # Local import avoids a circular import between database.models and
+    # anything that imports this module at startup.
+    from database.models import Officer
+
+    if latitude is None or longitude is None:
+        return None, None
+
+    query = Officer.query.filter(Officer.latitude.isnot(None), Officer.longitude.isnot(None))
+    if on_duty_only:
+        query = query.filter_by(on_duty=True)
+    candidates = query.all()
+
+    if not candidates:
+        return None, None
+
+    nearest = min(
+        candidates,
+        key=lambda o: haversine_km(latitude, longitude, o.latitude, o.longitude),
+    )
+    distance = round(haversine_km(latitude, longitude, nearest.latitude, nearest.longitude), 2)
+    return nearest, distance
+
+
+def maps_directions_url(latitude: float, longitude: float) -> str:
+    """A Google Maps 'directions to' link an officer can tap from a text/email alert."""
+    return f"https://www.google.com/maps/dir/?api=1&destination={latitude},{longitude}"
