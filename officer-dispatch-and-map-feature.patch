 from flask_sqlalchemy import SQLAlchemy
+from sqlalchemy import inspect, text
 
 # Single SQLAlchemy instance, imported by models.py and app.py.
 db = SQLAlchemy()
 
+# Columns added to already-existing tables after the initial release.
+# db.create_all() only creates *missing tables*, it never alters a table
+# that already exists — so anyone with a pre-existing stampede.db (e.g.
+# from before the officer-dispatch / zone-map feature) would otherwise
+# hit "no such column" errors. This runs a tiny, additive, SQLite-only
+# migration on startup instead of requiring Alembic for one release.
+_NEW_COLUMNS = {
+    "videos": [
+        ("zone_name", "VARCHAR(120)"),
+        ("latitude", "FLOAT"),
+        ("longitude", "FLOAT"),
+    ],
+    "alerts": [
+        ("zone_name", "VARCHAR(120)"),
+        ("latitude", "FLOAT"),
+        ("longitude", "FLOAT"),
+        ("dispatched_officer_id", "INTEGER"),
+        ("dispatched_distance_km", "FLOAT"),
+        ("dispatched_at", "DATETIME"),
+    ],
+}
+
+
+def _run_additive_migration(app):
+    """Add any missing columns from _NEW_COLUMNS to their tables in-place."""
+    engine = db.engine
+    if engine.dialect.name != "sqlite":
+        # Non-SQLite deployments (e.g. MySQL) should use a real migration
+        # tool; this shortcut is only safe for the bundled SQLite file.
+        return
+
+    inspector = inspect(engine)
+    existing_tables = set(inspector.get_table_names())
+
+    with engine.begin() as conn:
+        for table, columns in _NEW_COLUMNS.items():
+            if table not in existing_tables:
+                continue  # table doesn't exist yet, create_all() just made it fresh with all columns
+            existing_columns = {col["name"] for col in inspector.get_columns(table)}
+            for col_name, col_type in columns:
+                if col_name not in existing_columns:
+                    conn.execute(text(f"ALTER TABLE {table} ADD COLUMN {col_name} {col_type}"))
+
 
 def init_db(app):
