+"""
+scripts/seed_officers.py
+==========================
+One-off helper to seed a handful of demo officers around Nagpur so the
+nearest-officer dispatch feature has something to find without needing
+to click through the /officers admin form first.
+
+Usage (from the project root, with your virtualenv active):
+    python -m scripts.seed_officers
+
+Safe to run more than once — it skips any officer whose name already
+exists in the database.
+"""
+
+from app import app
+from database.database import db
+from database.models import Officer
+
+DEMO_OFFICERS = [
+    {
+        "name": "Head Constable R. Mokati",
+        "badge_id": "NG-1042",
+        "phone_number": "919800000001",
+        "email": "r.mokati@example-police.gov.in",
+        "zone_name": "Main Gate - Sector 4",
+        "latitude": 21.1466,
+        "longitude": 79.0882,
+        "on_duty": True,
+    },
+    {
+        "name": "Constable K. Vighre",
+        "badge_id": "NG-1077",
+        "phone_number": "919800000002",
+        "email": "k.vighre@example-police.gov.in",
+        "zone_name": "East Concourse",
+        "latitude": 21.1502,
+        "longitude": 79.0947,
+        "on_duty": True,
+    },
+    {
+        "name": "Constable G. Tong",
+        "badge_id": "NG-1103",
+        "phone_number": "919800000003",
+        "email": "g.tong@example-police.gov.in",
+        "zone_name": "West Parking Ground",
+        "latitude": 21.1390,
+        "longitude": 79.0790,
+        "on_duty": True,
+    },
+    {
+        "name": "Constable Y. Yadav",
+        "badge_id": "NG-1128",
+        "phone_number": "919800000004",
+        "email": "y.yadav@example-police.gov.in",
+        "zone_name": "North Watchtower",
+        "latitude": 21.1610,
+        "longitude": 79.0850,
+        "on_duty": False,  # example of an off-duty officer, excluded from dispatch
+    },
+]
+
+
+def run():
+    with app.app_context():
+        created = 0
+        for data in DEMO_OFFICERS:
+            if Officer.query.filter_by(name=data["name"]).first():
+                continue
+            db.session.add(Officer(**data))
+            created += 1
+        db.session.commit()
+        print(f"Seeded {created} officer(s). {Officer.query.count()} total in roster.")
+
+
+if __name__ == "__main__":
+    run()
