# Copy this file to ".env" and fill in your real values.
# ".env" is loaded automatically by config.py and should NEVER be
# committed to git — it holds your real email password and, below, the
# private key that lets this server send push notifications.

# --- Email alerts ----------------------------------------------------------
# Do NOT put a real app password in this example file. If one is already
# here, revoke it at https://myaccount.google.com/apppasswords and generate
# a fresh one — deleting the line afterwards does not remove it from git
# history, so the revocation is the part that actually matters.
ALERT_EMAIL_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=your-address@gmail.com
SMTP_PASSWORD=your-16-character-app-password
ALERT_EMAIL_FROM=your-address@gmail.com

# --- Two-factor login (email OTP) -----------------------------------------
# Uses the SAME SMTP settings above to email login codes. If SMTP isn't
# configured yet and FLASK_DEBUG=true, the code is printed to the app log
# instead (clearly labeled [DEV MODE]) so you can still test login locally.
TWO_FACTOR_ENABLED=true
FLASK_DEBUG=true

STAMPEDE_SECRET_KEY=change-this-in-production

# --- Reaching the officer app from a phone --------------------------------
# Browsers only allow geolocation and service workers in a "secure context".
# localhost counts; http://192.168.x.x does NOT, so an officer on a phone
# over plain HTTP can never go on duty. Set these for a LAN demo and accept
# the certificate warning. See README section 5.3.
#
# IMPORTANT: turn FLASK_DEBUG off whenever HOST is not 127.0.0.1. The
# Werkzeug debugger exposes an interactive Python console on error pages,
# and binding it to 0.0.0.0 offers remote code execution to everyone on the
# same Wi-Fi. Debug mode is fine on localhost; it is not fine on a network.
# HOST=0.0.0.0
# SSL_ADHOC=true
# FLASK_DEBUG=false


# ===========================================================================
# FIELD-OFFICER DISPATCH
# ===========================================================================
# Everything in this block has a working default, so the feature runs
# without setting any of it. Change these only with a reason.

# Master switch. false = alerts still fire and email as before, but no
# officer is ever paged.
DISPATCH_ENABLED=true

# How long one officer has to accept before the offer moves to the next
# nearest. Short enough that a venue does not wait on someone whose phone
# is in a locker; long enough to notice, read the location and tap.
DISPATCH_OFFER_TIMEOUT_SECONDS=25

# Give up and notify admins after this many officers have been asked.
DISPATCH_MAX_OFFERS=5

# Straight-line search radius. Officers further away than this are not
# offered the incident at all — better an explicit "nobody in range" than
# sending someone on a 40-minute drive.
DISPATCH_SEARCH_RADIUS_KM=15.0

# A repeat alert at the same place within this window reuses the existing
# incident instead of raising a duplicate. Prevents one sustained crowd
# surge from paging the roster five times.
DISPATCH_DEDUPE_WINDOW_SECONDS=600

# How often the officer app reports its position while on duty.
OFFICER_LOCATION_PING_SECONDS=20

# Past this age a position is treated as stale and the officer stops being
# offered incidents, even if they never tapped "off duty". A phone that
# died two hours ago must not look like it is standing by.
OFFICER_LOCATION_MAX_AGE_SECONDS=300

# Used only to print a rough "~6 min out" estimate to the officer. Straight
# -line distance divided by this. Not a routed ETA.
DISPATCH_AVERAGE_SPEED_KMH=25.0


# ===========================================================================
# WEB PUSH (optional — notifications while the app is closed)
# ===========================================================================
# Without these, dispatch still works: the officer app polls for offers
# every few seconds while it is open on screen. With them, the phone rings
# in a pocket.
#
#   pip install pywebpush
#   python scripts/generate_vapid_keys.py
#
# Paste the output here. Generate ONCE and keep it: changing the pair
# invalidates every device that already subscribed, and each officer has to
# re-enable background alerts.
#
# VAPID_SUBJECT must be a real contact — mailto: or https: — that the push
# services can use to reach you if this server starts misbehaving.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com


# ===========================================================================
# 3D DISPATCH SIMULATION  (Admin > 3D Simulation)
# ===========================================================================
# A WebGL view of camera sites, officers and live incidents. It drives the
# REAL engine - real ranking, real push, a real countdown - so incidents
# raised there are real rows, flagged is_simulated and excluded from the
# dispatch board's average response time. "Purge simulated data" on the page
# removes them. See README section 6.

# false still shows the page but refuses to raise incidents.
SIMULATION_ENABLED=true

# Ceiling on demo officer accounts, so a stuck loop in the browser cannot
# fill the users table.
SIMULATION_MAX_OFFICERS=12

# Where the "Seed venue" box starts. Only a default for the input - there is
# a "use my location" button beside it, and the value is editable.
SIMULATION_DEFAULT_LAT=19.0760
SIMULATION_DEFAULT_LON=72.8777
